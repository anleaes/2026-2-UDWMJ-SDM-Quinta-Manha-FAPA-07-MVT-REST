@startuml EscapeRoom
class Pessoa{
 -nome: Char
 -email: Email
 -telefone: Char
 -data_nascimento: Date
 -ativo: Boolean
 +toString()
}
class Cliente{
 -cpf: Char
 -cidade: Char
 -data_cadastro: Date
 -observacoes: Text
 +toString()
}
class Funcionario{
 -cargo: Char
 -data_admissao: Date
 -salario: Float
 -matricula: Char
 +toString()
}
class Participante{
 -documento: Char
 -menor_de_idade: Boolean
 -termo_responsabilidade: File
 -observacoes: Text
 +toString()
}
class Sala{
 -nome: Char
 -descricao: Text
 -capacidade_minima: Integer
 -capacidade_maxima: Integer
 -duracao_minutos: Integer
 -valor_base: Decimal
 -imagem: Image
 -ativa: Boolean
 +toString()
}
class Tema{
 -nome: Char
 -descricao: Text
 -faixa_etaria_minima: Integer
 -classificacao: CharChoices
 -ambientacao: Char
 -ativo: Boolean
 +toString()
}
class Jogo{
 -nome: Char
 -historia: Text
 -nivel_dificuldade: CharChoices
 -tempo_limite_minutos: Integer
 -pontuacao_maxima: Integer
 -instrucoes: Text
 -valor_adicional: Decimal
 -ativo: Boolean
 -sala: ForeignKey[Sala]
 -tema: ForeignKey[Tema]
 +toString()
}
class Horario{
 -data: Date
 -hora_inicio: Time
 -hora_fim: Time
 -vagas_disponiveis: Integer
 -status: CharChoices
 -jogo: ForeignKey[Jogo]
 +toString()
}
class Grupo{
 -nome: Char
 -tipo_grupo: CharChoices
 -tamanho_estimado: Integer
 -observacoes: Text
 -data_criacao: Date
 -cliente: ForeignKey[Cliente]
 -participantes: ManyToMany[Participante]
 +toString()
}
class Agendamento{
 -codigo: Char
 -criado_em: DateTime
 -quantidade_pessoas: Integer
 -valor_total: Decimal
 -desconto: Float
 -status: CharChoices
 -observacoes: Text
 -codigo_confirmacao: Char
 -cliente: ForeignKey[Cliente]
 -horario: ForeignKey[Horario]
 -grupo: ForeignKey[Grupo]
 +toString()
}
class Pagamento{
 -valor: Decimal
 -metodo: CharChoices
 -status: CharChoices
 -data_vencimento: Date
 -realizado_em: DateTime
 -codigo_transacao: Char
 -comprovante: File
 -agendamento: ForeignKey[Agendamento]
 +toString()
}
class Sessao{
 -codigo: Char
 -inicio_real: DateTime
 -fim_real: DateTime
 -status: CharChoices
 -resultado: CharChoices
 -observacoes: Text
 -pontuacao_final: Integer
 -agendamento: OneToOne[Agendamento]
 -funcionario: ForeignKey[Funcionario]
 +toString()
}
class Avaliacao{
 -nota: Integer
 -comentario: Text
 -recomendaria: Boolean
 -criada_em: DateTime
 -resposta_empresa: Text
 -nota_atendimento: Integer
 -cliente: ForeignKey[Cliente]
 -sessao: ForeignKey[Sessao]
 +toString()
}

Cliente -up-|> Pessoa : herança
Funcionario -up-|> Pessoa : herança
Participante -up-|> Pessoa : herança

Sala "1" --> "0..*" Jogo : disponibiliza
Tema "1" --> "0..*" Jogo : classifica
Jogo "1" --> "0..*" Horario : possui
Cliente "1" --> "0..*" Grupo : responsavel
Grupo "0..*" -- "0..*" Participante : possui (ManyToMany)
Cliente "1" --> "0..*" Agendamento : realiza
Horario "1" --> "0..*" Agendamento : recebe reservas
Grupo "1" --> "0..*" Agendamento : participa
Agendamento "1" --> "0..*" Pagamento : registra
Agendamento "1" -- "0..1" Sessao : gera (OneToOne)
Funcionario "1" --> "0..*" Sessao : conduz
Sessao "1" --> "0..*" Avaliacao : recebe
Cliente "1" --> "0..*" Avaliacao : escreve
@enduml
